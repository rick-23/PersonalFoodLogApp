# Copy to .env and fill in.
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/foodlog
# Any long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# How long a login lasts before the app asks you to sign in again.
JWT_EXPIRES_IN=30d
